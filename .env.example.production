# Configuration de production de DevKora (serveur Datacloud à Dakar).
# Sur le serveur : cp .env.example.production .env, puis remplis les valeurs marquées « À REMPLIR ».
# Aucun secret ici : la clé de l'application est générée par deploy.sh au premier déploiement,
# le mot de passe de la base est choisi sur le serveur et ne quitte jamais le serveur.

APP_NAME=DevKora
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# À REMPLIR : https://<domaine>. Le temps d'avoir le domaine : http://<IP du serveur>
APP_URL=https://devkora.example

# Mode démo : connexion en un clic avec les comptes de démonstration, et remise à zéro
# chaque nuit à 3 h, heure de Dakar (demo:reset). Le site du concours est une démo : true.
APP_DEMO=true

# Fuseau : Africa/Dakar, fixé dans config/app.php (UTC+0, sans heure d'été).
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Journal quotidien, gardé 14 jours, avertissements et erreurs seulement.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base PostgreSQL 16 locale, appartenant à l'utilisateur devkora.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=devkora
DB_USERNAME=devkora
# À REMPLIR sur le serveur (le mot de passe choisi à la création de l'utilisateur PostgreSQL).
DB_PASSWORD=

# Sessions en base, chiffrées, cookies réservés à HTTPS, inaccessibles au JavaScript.
# Pendant l'accès temporaire par l'IP (HTTP, sans certificat) : SESSION_SECURE_COOKIE=false,
# sinon la connexion est impossible. Repasse à true dès que le domaine est en HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Aucune tâche en file d'attente : tout est traité pendant la requête, pas de worker à surveiller.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=devkora

# Aucun e-mail réel n'est envoyé par la démo : les messages vont dans le journal.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="ne-pas-repondre@devkora.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
